{
  "name": "zuno-tools",
  "displayName": "Zuno Language Tools",
  "description": "Zuno language server with completion, definition, rename, diagnostics, and local run/check commands.",
  "version": "0.5.0",
  "publisher": "zuno-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onLanguage:zuno"
  ],
  "contributes": {
    "problemMatchers": [{
      "name": "zuno",
      "owner": "zuno",
      "fileLocation": "absolute",
      "pattern": { "regexp": "^(.+):(\\d+):(\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "message": 4 }
    }],
    "languages": [
      {
        "id": "zuno",
        "aliases": [
          "Zuno"
        ],
        "extensions": [
          ".zuno"
        ],
        "configuration": "language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zuno",
        "scopeName": "source.zuno",
        "path": "zuno.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "zuno.run",
        "title": "Zuno: Run current file"
      },
      {
        "command": "zuno.check",
        "title": "Zuno: Check current file"
      },
      {
        "command": "zuno.runProject",
        "title": "Zuno: Run project"
      },
      {
        "command": "zuno.checkProject",
        "title": "Zuno: Check project"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "zuno.run",
          "when": "resourceLangId == zuno",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Zuno",
      "properties": {
        "zuno.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Path to the Node.js executable used for Zuno tasks."
        }
      }
    }
  },
  "files": [
    "dist/**",
    "language-configuration.json",
    "zuno.tmLanguage.json",
    "README.md",
    "runtime/**"
  ]
}
